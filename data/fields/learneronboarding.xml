<?xml version="1.0" encoding="UTF-8"?>
<!-- One row per learner (id = user id), written by services/testu/learn/onboarding.json as the learner walks the
     first-run onboarding: `started` on the first screen, the goal chips and the "when do you learn" pick as they go,
     the first Learn session's score, `finished` on the last screen (never when skipped: the app shows the tour again on the next opens, up to its cap,
     and `opens` counts how many showings it took). The console reads the same
     endpoint with report=true. -->
<properties beanname="dataSearcher">
  <property id="id" index="true" stored="true" editable="false" keyword="true"><name><language id="en">ID</language></name></property>
  <property id="user" index="true" stored="true" editable="false" type="list" listid="user"><name><language id="en">Learner</language><language id="es">Alumno</language></name></property>
  <property id="started" index="true" stored="true" editable="false" type="date"><name><language id="en">Started</language><language id="es">Empezó</language></name></property>
  <property id="finished" index="true" stored="true" editable="false" type="date"><name><language id="en">Finished</language><language id="es">Terminó</language></name></property>
  <property id="opens" index="true" stored="true" editable="false" type="number"><name><language id="en">Times shown</language><language id="es">Veces mostrado</language></name></property>
  <property id="skipped" index="true" stored="true" editable="false" type="boolean"><name><language id="en">Skipped</language><language id="es">Saltado</language></name></property>
  <property id="goals" index="true" stored="true" editable="false" keyword="true"><name><language id="en">Goals (comma-separated)</language><language id="es">Objetivos</language></name></property>
  <property id="whenlearn" index="true" stored="true" editable="false" keyword="true"><name><language id="en">When they learn</language><language id="es">Cuándo aprende</language></name></property>
  <property id="notify" index="true" stored="true" editable="false" type="boolean"><name><language id="en">Daily reminder on</language><language id="es">Recordatorio diario activo</language></name></property>
  <property id="lastreminder" index="true" stored="true" editable="false" keyword="true"><name><language id="en">Last reminder (yyyyMMdd)</language><language id="es">Último recordatorio</language></name></property>
  <property id="sessiontotal" index="true" stored="true" editable="false" type="number"><name><language id="en">First session · questions</language><language id="es">Primera sesión · preguntas</language></name></property>
  <property id="sessioncorrect" index="true" stored="true" editable="false" type="number"><name><language id="en">First session · correct</language><language id="es">Primera sesión · aciertos</language></name></property>
</properties>
