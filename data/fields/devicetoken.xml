<?xml version="1.0" encoding="UTF-8"?>
<!-- One FCM registration token per learner device, written by services/testu/social/scripts/devicetoken.groovy
     (upsert on md5(token), deleted on sign-out or when FCM answers 404 UNREGISTERED) and read by the `push`
     in comment.groovy / react.groovy. `user` is type="list" so exact("user", ...) works without indextype. -->
<properties beanname="dataSearcher">
  <property id="id" index="true" stored="true" editable="false" keyword="true"><name><language id="en">ID</language></name></property>
  <property id="user" index="true" stored="true" editable="false" type="list" listid="user"><name><language id="en">Learner</language><language id="es">Alumno</language></name></property>
  <property id="token" index="true" stored="true" editable="false" keyword="true"><name><language id="en">FCM token</language></name></property>
  <property id="platform" index="true" stored="true" editable="false" keyword="true"><name><language id="en">Platform</language><language id="es">Plataforma</language></name></property>
  <property id="datecreated" index="true" stored="true" editable="false" type="date"><name><language id="en">Date</language><language id="es">Fecha</language></name></property>
</properties>
