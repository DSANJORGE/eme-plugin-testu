<?xml version="1.0" encoding="UTF-8"?>
<!-- Terms and Conditions versions, published by an admin via services/testu/personas/termspublish (TestUTermsModule).
     The PDF is the legal record: stored under originals/testu/terms/<id>.pdf (not served, not in git); filehash is its sha-256 hex.
     Current version = the latest publishedat. Never edited; no rows = no terms required. -->
<properties beanname="dataSearcher">
  <property id="id" index="true" stored="true" editable="false" keyword="true"><name><language id="en">ID</language></name></property>
  <property id="version" index="true" stored="true" editable="false" keyword="true"><name><language id="en">Version</language><language id="es">Versión</language></name></property>
  <property id="summary" index="false" stored="true" editable="false" viewtype="textarea"><name><language id="en">What changed</language><language id="es">Qué cambió</language></name></property>
  <property id="publishedat" index="true" stored="true" editable="false" type="date"><name><language id="en">Published</language><language id="es">Publicada</language></name></property>
  <property id="publishedby" index="true" stored="true" editable="false" type="list" listid="user"><name><language id="en">Published by</language><language id="es">Publicada por</language></name></property>
  <property id="filehash" index="true" stored="true" editable="false" keyword="true"><name><language id="en">File SHA-256</language><language id="es">SHA-256 del archivo</language></name></property>
  <property id="filesize" index="true" stored="true" editable="false" type="number" datatype="number"><name><language id="en">File size (bytes)</language><language id="es">Tamaño (bytes)</language></name></property>
  <property id="filename" index="true" stored="true" editable="false" keyword="true"><name><language id="en">File name</language><language id="es">Nombre del archivo</language></name></property>
</properties>
