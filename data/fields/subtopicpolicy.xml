<?xml version="1.0" encoding="UTF-8"?>
<!-- Learning engine v1: subtopic unlock policy per topic, append-only; one row per version (id = <topicid>_v<policyversion>).
     The highest policyversion of a topic is its current policy; no row = open (policy_not_configured). Written only by
     services/testu/learn/subtopicpolicy.json (permission training_manage): create-only, and only when the caller's expectedversion is
     still the latest (else 409 version_conflict); it also writes an auditevent. -->
<properties beanname="dataSearcher">
  <property id="id" index="true" stored="true" editable="false" keyword="true"><name><language id="en">ID</language></name></property>
  <property id="entitytopic" index="true" stored="true" editable="false" type="list" listid="entitytopic"><name><language id="en">Topic</language><language id="es">Tema</language></name></property>
  <property id="policyversion" index="true" stored="true" editable="false" type="number" datatype="number"><name><language id="en">Version</language><language id="es">Versión</language></name></property>
  <property id="unlockpolicy" index="true" stored="true" editable="false" keyword="true"><name><language id="en">Policy</language><language id="es">Política</language></name></property>
  <property id="requiredlevel" index="true" stored="true" editable="false" type="list" listid="masterylevel"><name><language id="en">Required level</language><language id="es">Nivel requerido</language></name></property>
  <property id="appliesto" index="true" stored="true" editable="false" keyword="true"><name><language id="en">Applies to</language><language id="es">Aplica a</language></name></property>
  <property id="sectionorder" index="true" stored="true" editable="false" type="text"><name><language id="en">Subtopic order (JSON)</language><language id="es">Orden de subtemas (JSON)</language></name></property>
  <property id="user" index="true" stored="true" editable="false" type="list" listid="user"><name><language id="en">Changed by</language><language id="es">Cambiado por</language></name></property>
  <property id="datecreated" index="true" stored="true" editable="false" type="date"><name><language id="en">Created</language><language id="es">Creado</language></name></property>
</properties>
