<?xml version="1.0" encoding="UTF-8"?>
<!-- Learning engine v1: the daily challenge served to a user on a day, so reopening returns the same set. id = <user>_<yyyyMMdd of localdate>;
     localdate = the org-local date in `timezone` (catalog setting testu_timezone, IANA; UTC when unset/invalid), datecreated = generation instant (UTC).
     `day` is a date (ES 2.4 types field names index-wide; tutordaily.day is a date). `questionlist` holds the JSON item list (bucket + reason per item)
     (not `questions`: tutormastery.questions is a long). -->
<properties beanname="dataSearcher">
  <property id="id" index="true" stored="true" editable="false" keyword="true"><name><language id="en">ID</language></name></property>
  <property id="user" index="true" stored="true" editable="false" type="list" listid="user"><name><language id="en">User</language><language id="es">Usuario</language></name></property>
  <property id="day" index="true" stored="true" editable="false" type="date"><name><language id="en">Day</language><language id="es">Día</language></name></property>
  <property id="localdate" index="true" stored="true" editable="false" keyword="true"><name><language id="en">Local date</language><language id="es">Fecha local</language></name></property>
  <property id="timezone" index="true" stored="true" editable="false"><name><language id="en">Timezone</language><language id="es">Zona horaria</language></name></property>
  <property id="questionlist" index="true" stored="true" editable="false" type="text"><name><language id="en">Questions (JSON)</language><language id="es">Preguntas (JSON)</language></name></property>
  <property id="algorithmversion" index="true" stored="true" editable="false" type="list"><name><language id="en">Algorithm</language><language id="es">Algoritmo</language></name></property>
  <property id="inputs" index="true" stored="true" editable="false" type="text"><name><language id="en">Inputs (JSON)</language><language id="es">Entradas (JSON)</language></name></property>
  <property id="datecreated" index="true" stored="true" editable="false" type="date"><name><language id="en">Created</language><language id="es">Creado</language></name></property>
</properties>
