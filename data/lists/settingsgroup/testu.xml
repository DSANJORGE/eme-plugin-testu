<?xml version="1.0" encoding="UTF-8"?>
<!-- TestU Personas roles. Base permission set copied verbatim from the stock
     "users" preset (plugins/catalog/html/data/lists/settingsgroup/user.xml);
     our personas_*/analytics_*/training_* permissions appended. No api-* on
     training/manager: admin reads/writes for those roles go through our own
     services, which apply scope. orgadmin is the operator role (Ruling R5):
     it's who local/pilot admins run as day to day, so it also carries the
     generic api-search-data|api-create-data|api-manage-users so it can use
     eMe's stock list-search and user-management endpoints directly, not
     just our personas_* actions. -->
<settingsgroups>
  <settingsgroup id="orgadmin" permissions="view|viewsidebarhelp|quickdownload|addtofavorites|viewhomelink|savesearch|edittablecolumns|createnewrecord|convert|download|viewupload|checkout|viewmyaccount|viewcategorynav|togglesidebar|emaillink|viewvoting|shareasset|viewconversions|embedasset|editadvancedsearch|changeattachment|editassetcategories|viewcroppingtool|comment|deletecomments|metadatageneral|assetpermissions|converthistory|viewmap|viewcomments|viewassets|asseteditorpickanylibrary|viewopencollections|addnewcollection|viewtimeline|showbadge|showcollectionpicker|viewmodulelist|quicksearch|viewsavedcollections|viewfeaturedcollections|copycategory|api-search-projects|viewentitiesbreadcrumb|viewentitiestopmenu|viewbreadcrumb|sidebar|sidebarhelp|mediaeditsave|mediaeditsaveas|viewaiagent|quickgallery|showpendingassets|downloadcategoryzip|personas_manage|personas_operate|personas_view|analytics_manage|analytics_operate|analytics_view|training_manage|training_operate|training_view|api-search-data|api-create-data|api-manage-users"><name><![CDATA[Administrador de organización]]></name></settingsgroup>
