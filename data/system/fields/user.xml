<?xml version="1.0" encoding="UTF-8"?>
<!-- Local dev: on a fresh install the system index maps user.email dynamically
     (plain analyzed string, no .sort subfield), so the email lookup behind
     sendusercode/token never finds anyone. Declaring the field not_analyzed makes
     the lookup use a plain match query, which works with that mapping. Merged
     with the stock user fields. -->
<!-- TestU Personas: team is the only extension of user. Ids are slugs [a-z0-9]+. -->
<properties>
  <property id="email" index="true" stored="true" keyword="true" editable="true" indextype="not_analyzed">Email</property>
  <property id="team" index="true" stored="true" editable="true" type="list" viewtype="list" datatype="list" listid="team" indextype="not_analyzed">Team</property>
  <!-- Learning engine v1: job roles drive topicrequirement (strictest wins). -->
  <property id="jobrole" index="true" stored="true" editable="true" type="list" viewtype="multiselect" datatype="list" listid="jobrole" indextype="not_analyzed">Job role</property>
  <!-- Job profiles: the primary profile orders the learner's topics; must be one of jobrole. -->
  <property id="primaryjobrole" index="true" stored="true" editable="true" type="list" viewtype="list" datatype="list" listid="jobrole" indextype="not_analyzed">Primary job profile</property>
  <!-- Support / internal account (TestU staff inside a client org): learns like anyone, records are written as usual,
       but every analytics screen, report and forecast leaves it out (TestUAnalyticsModule.countsAsPerson). Set by hand
       (personas/setinternal.json), by the users CSV `internal` column, or on creation when the email domain is in the
       catalog setting testu_internaldomains (comma-separated). -->
  <property id="internal" index="true" stored="true" editable="true" type="boolean" datatype="boolean">Internal (support) account</property>
  <!-- Daily Challenge email: the learner's IANA zone (e.g. America/Lima), so the 09:00 email is their 09:00. Empty = the org's
       catalog setting testu_timezone. Set by hand or by an admin; nothing fills it automatically yet. -->
  <property id="timezone" index="true" stored="true" editable="true" keyword="true" indextype="not_analyzed">Timezone</property>
</properties>
